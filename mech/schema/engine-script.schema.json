{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "engine-script.schema.json",
  "title": "Kịch bản video động cơ 4 kỳ (bản tác giả / AI viết)",
  "description": "Mỗi beat là một cảnh có lời đọc. Thời gian tuyệt đối do tools/build-video.mjs tính từ độ dài lời đọc. Tên shot / bộ phận / mũi tên / điểm neo phải nằm trong danh sách enum (từ vựng của scene.js).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "topic",
    "title",
    "beats"
  ],
  "properties": {
    "topic": {
      "const": "engine",
      "description": "Chủ đề: chọn schema + luật kiểm tra động cơ"
    },
    "$schema": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "enum": [
            "say",
            "kokoro"
          ],
          "description": "say: macOS (có giọng tiếng Việt Linh); kokoro: hyperframes tts (chỉ tiếng Anh và một số ngôn ngữ khác)"
        },
        "voice": {
          "type": "string"
        },
        "rate": {
          "type": "number",
          "minimum": 120,
          "maximum": 260,
          "description": "Từ/phút cho provider say"
        },
        "speed": {
          "type": "number",
          "minimum": 0.6,
          "maximum": 1.6,
          "description": "Hệ số tốc độ cho provider kokoro"
        }
      }
    },
    "music": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "bpm": {
          "type": "number",
          "minimum": 70,
          "maximum": 140
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lead": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "description": "Giây chờ từ đầu beat tới khi bắt đầu đọc"
        },
        "pad": {
          "type": "number",
          "minimum": 0,
          "maximum": 3,
          "description": "Giây nghỉ sau lời đọc"
        },
        "snapToBeat": {
          "type": "boolean",
          "description": "Làm tròn độ dài beat lên bội số phách nhạc để chuyển cảnh trúng nhịp"
        },
        "maxDuration": {
          "type": "number",
          "minimum": 5,
          "maximum": 600,
          "description": "Cảnh báo nếu tổng thời lượng vượt (Shorts: 60)"
        }
      }
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "$ref": "#/$defs/beat"
      }
    }
  },
  "$defs": {
    "beat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "narration",
        "shot",
        "caption"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "narration": {
          "type": "string",
          "minLength": 2,
          "maxLength": 400,
          "description": "Lời đọc của beat"
        },
        "minDuration": {
          "type": "number",
          "minimum": 1,
          "maximum": 30
        },
        "shot": {
          "$ref": "#/$defs/shot"
        },
        "orbit": {
          "type": "number",
          "minimum": -1.5,
          "maximum": 1.5,
          "description": "Xoay camera (rad) tới cuối beat"
        },
        "transition": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 3
        },
        "caption": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "sub": {
          "type": "string",
          "maxLength": 80
        },
        "highlight": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/part"
          }
        },
        "cut": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cut"
          }
        },
        "arrows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/arrow"
          }
        },
        "hud": {
          "type": "boolean"
        },
        "tags": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/tag"
          }
        },
        "drive": {
          "type": "object",
          "additionalProperties": false,
          "description": "Góc trục khuỷu cộng dồn (độ) đạt tới cuối cảnh. 0 = điểm chết trên đầu kỳ nạp; mỗi kỳ 180°, mỗi chu trình 720°.",
          "properties": {
            "crank": {
              "$ref": "#/$defs/crankTarget"
            }
          }
        }
      }
    },
    "shot": {
      "enum": [
        "hero",
        "overview",
        "sideCut",
        "headCut",
        "crankCut"
      ]
    },
    "part": {
      "enum": [
        "piston",
        "rod",
        "crank",
        "cylinder",
        "head",
        "crankcase",
        "intakeValve",
        "exhaustValve",
        "valveSprings",
        "intakeCam",
        "exhaustCam",
        "sparkPlug",
        "gas"
      ]
    },
    "cut": {
      "enum": [
        "engine"
      ]
    },
    "arrow": {
      "enum": [
        "crankSpin",
        "pistonMove",
        "intakeFlow",
        "exhaustFlow",
        "powerPush"
      ]
    },
    "anchor": {
      "enum": [
        "piston",
        "rod",
        "crank",
        "cylinder",
        "chamber",
        "intakeValve",
        "exhaustValve",
        "intakeCam",
        "exhaustCam",
        "sparkPlug",
        "intakePort",
        "exhaustPort"
      ]
    },
    "tag": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "anchor"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "anchor": {
          "$ref": "#/$defs/anchor"
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "dx": {
          "type": "number",
          "minimum": -400,
          "maximum": 400
        },
        "dy": {
          "type": "number",
          "minimum": -400,
          "maximum": 400
        }
      }
    },
    "ramp": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "description": "Khoảng [đầu, cuối] trong beat (tỉ lệ 0–1) để chuyển tới giá trị đích"
    },
    "crankTarget": {
      "oneOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 100000
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "to"
          ],
          "properties": {
            "to": {
              "type": "number",
              "minimum": 0,
              "maximum": 100000
            },
            "ramp": {
              "$ref": "#/$defs/ramp"
            }
          }
        }
      ]
    }
  }
}